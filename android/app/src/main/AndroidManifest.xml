    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:hardwareAccelerated="true" android:theme="@style/AppTheme" android:label="IQ Match" android:icon="@drawable/iq_match_icon" android:roundIcon="@drawable/iq_match_icon" android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
